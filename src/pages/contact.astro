---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { company } from '../data/site';
---
<Base title="Contact Amica Digital Services, Manchester" description="Contact Amica Digital Services Ltd, 378 Claremont Road, Manchester M14 7WB. Call +44 7446 981768, send a message or book a free 20-minute call.">
  <PageHero eyebrow="Contact" title="Get in touch" lead="Tell us a little about your business and what you need. We reply within one working hour during office hours. For the quickest answer, book a call." crumbs={[{ label: 'Contact' }]} />
  <section class="section-sm">
    <div class="container split" style="align-items:start">
      <div class="card">
        <h2 class="form-title">Send us an enquiry</h2>
        <EnquiryForm variant="contact" />
        <noscript><p class="notice">The form needs JavaScript. Please call <a href={`tel:${company.phoneHref}`}>{company.phone}</a> or email <a href={`mailto:${company.email}`}>{company.email}</a>.</p></noscript>
      </div>
      <div>
        <div class="grid" style="gap:14px">
          <a class="card row" href="/book-a-consultation"><div class="icon-badge"><Icon name="calendar" /></div><div><h3>Book a call</h3><p>Choose a time for a free 20-minute call.</p></div></a>
          <a class="card row" href={`mailto:${company.email}`}><div class="icon-badge"><Icon name="mail" /></div><div><h3>Email</h3><p>{company.email}</p></div></a>
          {company.phone && <a class="card row" href={`tel:${company.phoneHref}`}><div class="icon-badge"><Icon name="phone" /></div><div><h3>Phone</h3><p>{company.phone}</p></div></a>}
          {company.whatsapp && <a class="card row" href={`https://wa.me/${company.whatsapp}`} rel="noopener"><div class="icon-badge"><Icon name="whatsapp" /></div><div><h3>WhatsApp</h3><p>Message us on WhatsApp</p></div></a>}
        </div>
        {company.address && <p style="margin-top:24px"><strong>Address</strong><br />{company.address}</p>}
        <p><strong>Hours</strong><br />{company.hours}</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .row { display: flex; gap: 16px; align-items: center; padding: 20px; }
  .row h3 { margin: 0; }
  .row > div:last-child { min-width: 0; }
  .row p { overflow-wrap: anywhere; }
  .row .icon-badge { flex-shrink: 0; }
  .form-title { font-size: 1.4rem; }
  @media (max-width: 640px) { .split > .card { padding: 22px 18px; } }
</style>
