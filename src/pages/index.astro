---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import FlowGraphic from '../components/FlowGraphic.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { services } from '../data/services';

const faqs = [
  { q: 'Who do you work with?', a: 'Mainly UK care and recruitment agencies, dental and aesthetic clinics, healthcare recruiters and other CQC-regulated or appointment-based businesses. We also help other service businesses that rely on fast follow-up.' },
  { q: 'Does automation replace my office team?', a: 'No. It takes repetitive tasks off them, such as first replies, reminders and chasing, so they have more time for families, clients and staff. Your team can see and step into every conversation.' },
  { q: 'How much does it cost?', a: 'Our Care and Recruitment Agency Automation Package is £490 per month with no setup fee on a 12-month agreement, or £990 setup plus £490 per month with no minimum term. Other projects are quoted after a short call.' },
  { q: 'How long does setup take?', a: 'Implementation normally takes four to six weeks, depending on scope and how quickly we receive the information we need from you.' },
  { q: 'Do I need to already use GoHighLevel?', a: 'No. We can set it up from scratch, or audit and improve an account you already have.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Amica Digital Services | AI Automation and CRM for UK Care Agencies"
  description="Amica Digital Services helps UK care agencies, clinics and recruitment teams reply to every enquiry fast, book more calls and cut admin with AI automation and GoHighLevel CRM."
  schema={[faqSchema]}
>
  <section class="hero">
    <div class="container split">
      <div>
        <span class="eyebrow">AI automation for UK care and service businesses</span>
        <h1>Reply to every enquiry in minutes, even when your team is out on calls</h1>
        <p class="lead">
          Amica sets up the systems that answer new enquiries straight away, book calls and interviews into your diary and send the reminders, so families, clients and applicants do not go elsewhere while your team is busy.
        </p>
        <div class="btn-row">
          <a href="/book-a-consultation" class="btn btn-primary">Book a free 20-minute call <Icon name="arrow" /></a>
          <a href="/care-agency-automation" class="btn btn-secondary">See the care agency package</a>
        </div>
        <ul class="hero-points">
          <li><Icon name="check" /> UK-based team</li>
          <li><Icon name="check" /> Built with UK GDPR in mind</li>
          <li><Icon name="check" /> Your staff stay in control</li>
        </ul>
      </div>
      <div class="hero-visual">
        <Picture src="/images/hero.jpg" alt="Care coordinator working at a laptop in a bright office" eager>
          <FlowGraphic slot="fallback" />
        </Picture>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="center">
        <span class="eyebrow">The problem</span>
        <h2>Where good enquiries get lost</h2>
        <p class="lead">Most agencies do not have a marketing problem. They have a response-time problem. The enquiry arrives, but nobody is free to reply properly.</p>
      </div>
      <div class="grid grid-4" style="margin-top:40px">
        <div class="card"><div class="icon-badge"><Icon name="phone" /></div><h3>Missed calls</h3><p>Calls come in while staff are on visits or covering a shift, and the caller rings the next agency.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="clock" /></div><h3>Slow replies</h3><p>Website and email enquiries wait until someone has a spare moment, often the next day.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="users" /></div><h3>Applicants drop out</h3><p>Care workers apply to several agencies. The first to arrange an interview usually wins.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="chart" /></div><h3>No clear view</h3><p>Leads sit across inboxes, phones and spreadsheets, so nobody knows what was followed up.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Care and Recruitment Agency Automation Package</span>
        <h2>One system for client enquiries, recruitment and follow-up</h2>
        <p class="lead">A done-for-you setup built around how your office already works.</p>
        <ul class="checklist" style="margin-top:20px">
          <li>CRM and sales pipeline for client and staff enquiries</li>
          <li>Instant replies to website, phone and social enquiries</li>
          <li>Missed-call text-back</li>
          <li>Online booking for assessments, calls and interviews</li>
          <li>Candidate recruitment and onboarding workflows</li>
          <li>Email, SMS and WhatsApp follow-up</li>
          <li>Review requests and reporting dashboard</li>
        </ul>
        <div class="btn-row">
          <a href="/care-agency-automation" class="btn btn-primary">See the full package</a>
          <a href="/pricing" class="btn btn-secondary">View pricing</a>
        </div>
      </div>
      <div class="card price-highlight">
        <span class="tag">Most popular</span>
        <p class="price">£490<small> / month</small></p>
        <p>No setup fee on a 12-month agreement.</p>
        <p class="muted">Or £990 setup plus £490 per month, cancel anytime. First month payable in advance. Implementation normally takes four to six weeks.</p>
        <a href="/book-a-consultation" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:12px">Book a free call</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="center">
        <span class="eyebrow">Services</span>
        <h2>Everything needed to turn enquiries into appointments</h2>
        <p class="lead">Pick one service or combine them into a complete system.</p>
      </div>
      <div class="grid grid-3" style="margin-top:40px">
        {services.map((s) => (
          <a href={`/${s.slug}`} class="card">
            <div class="icon-badge"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
            <span class="more">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center">
        <span class="eyebrow">How it works</span>
        <h2>From first call to a working system</h2>
      </div>
      <div class="grid grid-3 steps" style="margin-top:40px">
        <div class="card step"><h3>Free 20-minute call</h3><p>We look at how enquiries and applicants reach you today and where they are being lost.</p></div>
        <div class="card step"><h3>Build and test</h3><p>We set up your CRM, forms, booking and follow-up, and test everything with your team before it goes live.</p></div>
        <div class="card step"><h3>Launch and support</h3><p>We train your team, monitor results and keep improving the system month by month.</p></div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="center">
        <span class="eyebrow">Who we help</span>
        <h2>Built for businesses where every enquiry matters</h2>
      </div>
      <div class="grid grid-4" style="margin-top:40px">
        <a href="/care-agency-automation" class="card"><div class="icon-badge"><Icon name="heart" /></div><h3>Care agencies</h3><p>Home care, supported living and care recruitment.</p></a>
        <a href="/industries#clinics" class="card"><div class="icon-badge"><Icon name="tooth" /></div><h3>Dental and aesthetic clinics</h3><p>Fill appointment books and reduce no-shows.</p></a>
        <a href="/industries#recruitment" class="card"><div class="icon-badge"><Icon name="briefcase" /></div><h3>Healthcare recruitment</h3><p>Respond to candidates and clients faster.</p></a>
        <a href="/industries#regulated" class="card"><div class="icon-badge"><Icon name="building" /></div><h3>CQC-regulated services</h3><p>Organised, auditable communication.</p></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:860px">
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding: 72px 0 84px; background: radial-gradient(1200px 500px at 85% -10%, #e3f4f1 0%, transparent 60%), var(--bg); }
  .hero h1 { margin-top: 4px; }
  .hero-points { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; color: var(--muted); font-weight: 600; font-size: 0.95rem; }
  .hero-points li { display: flex; align-items: center; gap: 6px; }
  .hero-points :global(svg) { width: 18px; height: 18px; color: var(--teal); }
  .btn :global(svg) { width: 18px; height: 18px; }
  .price-highlight { padding: 36px; }
  .price-highlight .muted { color: var(--muted); font-size: 0.95rem; }
</style>
