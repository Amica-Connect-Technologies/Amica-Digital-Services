---
// Online order + payment for "Website from £199" (noindex, not linked until payments are live).
// Posts to /api/order on the deploy server, which logs the terms acceptance in GHL and
// opens Stripe Checkout (one-off build fee, no subscription).
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { company } from '../../data/site';
import { websiteOffer as W } from '../../data/pricing';
---
<Base title={`Order your £${W.setup} website`} description="Order and pay online for the Website from £199." noindex>
  <PageHero eyebrow="Order online" title={`Order your website from £${W.setup}`} lead="Enter your business details, accept the terms and pay securely online. You get a confirmation straight away, with no paperwork to sign." />
  <section class="section-sm">
    <div class="container" style="max-width:820px">
      <div class="card order-sum">
        <table>
          <tr><td>Website build (one-off)</td><td>£{W.setup}.00</td></tr>
          <tr><td>Monthly fee</td><td>None</td></tr>
        </table>
        <p class="order-today">You pay £{W.setup}.00 once. There is no subscription and nothing else is charged automatically.</p>
        <p class="order-small">Domain and hosting are not included. We agree them with you separately before your website goes live, or we connect your own. {company.legalName} is not VAT registered, so no VAT is added. For businesses and sole traders only.</p>
      </div>

      <form class="card order-form" data-order="website199" novalidate>
        <h2>Your business details</h2>
        <div class="o-grid">
          <div class="o-field"><label for="o-company">Business name *</label><input id="o-company" name="company" type="text" required maxlength="160" autocomplete="organization" /></div>
          <div class="o-field"><label for="o-name">Your full name *</label><input id="o-name" name="name" type="text" required maxlength="120" autocomplete="name" /></div>
          <div class="o-field"><label for="o-email">Email *</label><input id="o-email" name="email" type="email" required maxlength="160" autocomplete="email" /></div>
          <div class="o-field"><label for="o-phone">Phone *</label><input id="o-phone" name="phone" type="tel" required maxlength="40" autocomplete="tel" /></div>
          <div class="o-field"><label for="o-type">Business type *</label>
            <select id="o-type" name="businessType" required><option value="">Please choose</option><option>Limited company</option><option>Sole trader</option><option>Partnership or LLP</option><option>Charity or other organisation</option></select></div>
          <div class="o-field"><label for="o-number">Company number (if limited)</label><input id="o-number" name="companyNumber" type="text" maxlength="12" placeholder="8 characters" /></div>
          <div class="o-field o-wide"><label for="o-address">Business address and postcode *</label><input id="o-address" name="address" type="text" required maxlength="300" autocomplete="street-address" /></div>
        </div>
        <input type="hidden" name="terms_version" value={W.termsVersion} />
        <label class="o-check"><input type="checkbox" name="terms_ack" value="yes" required /> <span>I have read and accept the <a href="/terms#website-199" target="_blank">Website from £{W.setup} terms</a>. *</span></label>
        <label class="o-check"><input type="checkbox" name="b2b_ack" value="yes" required /> <span>I am buying for my business, trade or profession, not as a consumer. *</span></label>
        <label class="o-check"><input type="checkbox" name="privacy_ack" value="yes" required /> <span>I have read the <a href="/privacy-policy" target="_blank">privacy policy</a>. *</span></label>
        <button class="btn btn-primary" type="submit">Continue to secure payment</button>
        <p class="o-msg" role="alert" hidden></p>
        <p class="order-small">Pay by card, Apple Pay or Google Pay through Stripe. We never see or store your card details.</p>
      </form>
    </div>
  </section>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('form[data-order]');
  if (form) {
    const msg = form.querySelector<HTMLElement>('.o-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const show = (t: string) => { msg.textContent = t; msg.hidden = false; msg.scrollIntoView({ block: 'center', behavior: 'smooth' }); };
    if (new URLSearchParams(location.search).get('cancelled')) show('Payment was cancelled. Nothing has been charged. You can try again below.');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.hidden = true;
      const bad = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')].find((el) =>
        el instanceof HTMLInputElement && el.type === 'checkbox' ? !el.checked : !el.value.trim() || (el.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(el.value.trim())));
      if (bad) { show('Please complete every field marked * and tick the three boxes.'); bad.focus({ preventScroll: true }); return; }
      const data: Record<string, string> = { product: form.dataset.order || '' };
      new FormData(form).forEach((v, k) => { data[k] = String(v); });
      btn.disabled = true; btn.textContent = 'Opening secure payment…';
      try {
        const r = await fetch('/api/order', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) });
        const d = await r.json().catch(() => ({}));
        if (r.ok && d.url) { location.href = d.url; return; }
        show(r.status === 503 ? 'Online payment is not available at the moment. Please call or email us and we will help you order.' : r.status === 422 ? 'Please check your details: every field marked * is needed.' : 'Sorry, we could not open the payment page. Please try again, or contact us.');
      } catch { show('Sorry, we could not open the payment page. Please check your connection and try again.'); }
      btn.disabled = false; btn.textContent = 'Continue to secure payment';
    });
  }
</script>
<style>
  .order-sum table { width: 100%; border-collapse: collapse; }
  .order-sum td { padding: 8px 0; border-bottom: 1px solid #e3e7ec; }
  .order-sum td:last-child { text-align: right; white-space: nowrap; font-weight: 700; }
  .order-today { font-weight: 700; margin: 14px 0 6px; }
  .order-small { color: var(--muted); font-size: 0.9rem; margin: 8px 0 0; }
  .order-form { margin-top: 24px; }
  .order-form h2 { font-size: 1.35rem; }
  .o-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; margin: 16px 0 20px; }
  .o-wide { grid-column: 1 / -1; }
  @media (max-width: 640px) { .o-grid { grid-template-columns: 1fr; } }
  .o-field label { display: block; font-weight: 700; color: var(--navy); margin-bottom: 6px; }
  .order-form input[type='text'], .order-form input[type='email'], .order-form input[type='tel'], .order-form select { width: 100%; font: inherit; border: 1.5px solid #b9c1ca; border-radius: 10px; padding: 11px 13px; min-height: 48px; background: #fff; }
  .o-check { display: flex; gap: 10px; align-items: flex-start; margin: 0 0 12px; line-height: 1.45; cursor: pointer; }
  .o-check input { width: 20px; height: 20px; margin: 2px 0 0; flex-shrink: 0; accent-color: var(--teal-dark); }
  .order-form .btn { margin-top: 10px; }
  .o-msg { margin-top: 14px; padding: 12px 16px; border-radius: 8px; background: var(--coral-soft); color: var(--navy); font-weight: 600; }
</style>
