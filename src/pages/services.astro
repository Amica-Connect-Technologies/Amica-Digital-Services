---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
---
<Base title="Services" description="AI automation, voice agents, chatbots, GoHighLevel CRM, lead generation and websites from Amica Digital Services, built for UK care and service businesses.">
  <PageHero eyebrow="Services" title="Services that turn enquiries into appointments" lead="Choose a single service or combine them into one joined-up system, managed by a UK team." crumbs={[{ label: 'Services' }]} />
  <section class="section">
    <div class="container">
      <a href="/care-agency-automation" class="card feature">
        <div class="icon-badge"><Icon name="heart" /></div>
        <div>
          <span class="tag">Package</span>
          <h3>Care and Recruitment Agency Automation</h3>
          <p>Our complete package for UK care and recruitment agencies, from £490 per month.</p>
          <span class="more">See the package →</span>
        </div>
      </a>
      <div class="grid grid-3" style="margin-top:24px">
        {services.map((s) => (
          <a href={`/${s.slug}`} class="card">
            <div class="icon-badge"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
            <span class="more">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .feature { display: flex; gap: 20px; align-items: flex-start; border: 2px solid var(--teal); }
  .feature h3 { margin-top: 10px; }
</style>
