---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import FlowGraphic from '../components/FlowGraphic.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { faqSchema, serviceSchema } from '../data/schema';

const title = 'Recruitment Agency Automation and CRM (UK) | Amica';
const description =
  'Automation and CRM for UK recruitment agencies: candidate registration, screening, interview booking, compliance document chasing and client follow-up.';

const faqs = [
  { q: 'What is recruitment agency automation?', a: 'It uses a CRM and workflows to handle the repetitive steps around candidates and clients: acknowledging registrations, asking screening questions, booking interviews, sending reminders and chasing documents. Your recruiters stay in control and step in wherever a person is needed.' },
  { q: 'Will it replace our recruiters?', a: 'No. It takes the chasing and first replies off their desks so they can spend more time speaking to candidates and clients. Recruiters can see and take over any conversation.' },
  { q: 'Do we have to replace our ATS?', a: 'No. We check what your current ATS or recruitment CRM allows during the discovery call. Where a direct link is possible we connect the two; where it is not, we agree a simple handover process.' },
  { q: 'Can it collect right-to-work and DBS documents?', a: 'It can request documents, send upload links and remind candidates until everything is in. The checks themselves are still carried out by your team, following GOV.UK guidance.' },
  { q: 'How much does it cost?', a: '£490 per month with no setup fee on a 12-month agreement, or £990 setup plus £490 per month on a rolling 30-day plan. It is the same Care and Recruitment Agency Automation Package, scoped around recruitment.' },
  { q: 'How long does setup take?', a: 'Implementation normally takes four to six weeks, depending on scope and how quickly we receive the information we need from you.' },
];

const schema = [
  serviceSchema({
    name: 'Recruitment Agency Automation and CRM',
    serviceType: 'Recruitment automation',
    description,
    path: '/recruitment-agency-automation',
    audience: 'Recruitment and staffing agencies',
    offers: [
      { '@type': 'Offer', name: '12-month agreement', price: '490', priceCurrency: 'GBP', description: '£490 per month, no setup fee' },
      { '@type': 'Offer', name: 'Rolling 30-day plan', price: '990', priceCurrency: 'GBP', description: '£990 setup plus £490 per month, rolling 30-day plan' },
    ],
  }),
  faqSchema(faqs),
];
---
<Base title={title} description={description} schema={schema}>
  <PageHero
    eyebrow="For UK recruitment and staffing agencies"
    title="Automation and CRM for UK Recruitment Agencies"
    lead="Recruitment agency automation uses a CRM and workflows to handle the repetitive steps around candidates and clients: acknowledging registrations, screening, booking interviews, sending reminders and chasing compliance documents. Amica Digital Services sets this up for UK recruitment and staffing agencies, mainly in GoHighLevel, alongside the ATS you already use."
    crumbs={[{ label: 'Care and Recruitment', href: '/care-agency-automation' }, { label: 'Recruitment Agency Automation' }]}
  >
    <div class="btn-row">
      <a href="/book-a-consultation" class="btn btn-primary">Book a free 20-minute call</a>
      <a href="#pricing" class="btn btn-secondary">See pricing</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Good candidates do not stay available for long</h2>
        <p class="lead">Candidates and clients both expect fast responses. When registrations wait for a reply and interviews take days to arrange, the best people accept another offer first.</p>
        <ul class="checklist crosslist" style="margin-top:20px">
          <li>New registrations sit in an inbox until someone has time to reply</li>
          <li>Recruiters spend hours booking, confirming and rebooking interviews</li>
          <li>Compliance documents are chased one email at a time</li>
          <li>Client enquiries and job orders are tracked in spreadsheets and memory</li>
        </ul>
      </div>
      <Picture src="/images/recruitment-automation.jpg" alt="Recruitment team reviewing candidate profiles and an automated interview booking workflow on screen" ratio="4 / 3">
        <FlowGraphic slot="fallback" />
      </Picture>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="center">
        <span class="eyebrow">What is included</span>
        <h2>What we set up for your agency</h2>
        <p class="lead">We build around your desks, your sectors and your current process, and agree the scope with you in writing before we start.</p>
      </div>
      <div class="grid grid-3" style="margin-top:40px">
        <div class="card"><div class="icon-badge"><Icon name="users" /></div><h3>Candidate registration</h3><p>Every registration, from your website, job boards or social media, gets an instant personal reply and lands in the right pipeline stage.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="check" /></div><h3>Screening questions</h3><p>Short screening questions by form, SMS or WhatsApp, such as location, availability and right to work, so recruiters see the essentials first.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="calendar" /></div><h3>Interview scheduling and reminders</h3><p>Candidates book interviews into your recruiters' calendars, with confirmation and reminder messages and a simple way to rebook.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="shield" /></div><h3>Compliance document collection</h3><p>Automatic requests and reminders for the documents you need, so your team only steps in when something is missing.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="briefcase" /></div><h3>Client enquiry pipeline</h3><p>A separate pipeline for client enquiries and job orders, with instant replies and follow-up tasks so no new client waits.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="mail" /></div><h3>Re-engaging past candidates</h3><p>Opt-in messages to past candidates when a suitable role comes up, sent with UK GDPR and consent in mind.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="phone" /></div><h3>Missed-call text-back</h3><p>If nobody can answer, the caller gets a text straight away with a link to register or book a call back.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="chat" /></div><h3>AI chatbot (optional)</h3><p>An assistant on your website or WhatsApp that answers common questions about registering and passes candidates to a recruiter.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="chart" /></div><h3>Reporting</h3><p>A dashboard showing registrations, response times, interviews booked and documents outstanding.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose" style="max-width:820px">
      <span class="eyebrow">Working alongside your ATS</span>
      <h2>A CRM for the front end, not a replacement for your ATS</h2>
      <p>Most agencies already have an applicant tracking system or recruitment CRM that holds placements, timesheets and compliance records. We do not ask you to replace it. GoHighLevel handles the fast-moving front end: first replies, screening, booking, reminders and chasing.</p>
      <p>During the discovery call we check what your current system allows. Where a direct link is possible we connect the two, so candidates move across when they are ready. Where it is not, we agree a simple handover process so nobody re-types the same details twice.</p>
      <p>If you also want more candidates and clients to find you, we can support the system with <a href="/seo">SEO for recruitment agencies</a> and <a href="/lead-generation">lead generation</a>.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="center"><span class="eyebrow">How it works</span><h2>Live in four to six weeks</h2></div>
      <div class="grid grid-4 steps" style="margin-top:40px">
        <div class="card step"><h3>Discovery</h3><p>A free call to understand your desks, candidate journey, client process and current tools.</p></div>
        <div class="card step"><h3>Plan</h3><p>We agree scope, messages and workflows in writing before building.</p></div>
        <div class="card step"><h3>Build and test</h3><p>We build everything and test it with your recruiters before going live.</p></div>
        <div class="card step"><h3>Launch and support</h3><p>Go live, train your team, then review and improve every month.</p></div>
      </div>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="container">
      <div class="center"><span class="eyebrow">Pricing</span><h2>Simple monthly pricing</h2><p class="lead">Recruitment automation is part of our Care and Recruitment Agency Automation Package, scoped around how your agency recruits.</p></div>
      <div class="grid grid-2 pricing" style="margin-top:44px">
        <div class="card price-card featured">
          <span class="badge">Best value</span>
          <h3>12-month agreement</h3>
          <p class="price">£490<small> / month</small></p>
          <p>No setup fee</p>
          <ul class="checklist">
            <li>Full package setup included</li>
            <li>Ongoing management and support</li>
            <li>Monthly review and improvements</li>
            <li>First month payable in advance</li>
          </ul>
          <a href="/book-a-consultation" class="btn btn-primary">Book a free call</a>
        </div>
        <div class="card price-card">
          <h3>Rolling 30-day plan</h3>
          <p class="price">£490<small> / month</small></p>
          <p>Plus £990 one-off setup</p>
          <ul class="checklist">
            <li>Same package and support</li>
            <li>No minimum term, 30 days' notice</li>
            <li>Monthly review and improvements</li>
            <li>First month payable in advance</li>
          </ul>
          <a href="/book-a-consultation" class="btn btn-secondary">Book a free call</a>
        </div>
      </div>
      <p class="center small">Third-party usage costs, such as SMS, WhatsApp, phone numbers or advertising spend, may apply and will be confirmed in your written quote before work starts.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width:860px">
      <Faq items={faqs} />
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <h2>Related pages</h2>
      <div class="grid grid-3" style="margin-top:24px">
        <a href="/crm-gohighlevel" class="card"><div class="icon-badge"><Icon name="crm" /></div><h3>GoHighLevel CRM setup</h3><p>How we set up and manage GoHighLevel for UK businesses.</p><span class="more">Learn more →</span></a>
        <a href="/care-agency-automation" class="card"><div class="icon-badge"><Icon name="heart" /></div><h3>Care and recruitment automation</h3><p>The full package, including care client enquiries.</p><span class="more">Learn more →</span></a>
        <a href="/blog/recruitment-automation-uk-agencies" class="card"><div class="icon-badge"><Icon name="bolt" /></div><h3>What to automate first</h3><p>Our guide to recruitment automation for UK agencies.</p><span class="more">Read the article →</span></a>
      </div>
    </div>
  </section>

  <CtaBand title="Find out where your agency is losing candidates" />
</Base>
<style>
  .pricing { max-width: 860px; margin-left: auto; margin-right: auto; }
  .small { font-size: 0.9rem; color: var(--muted); margin-top: 24px; }
</style>
