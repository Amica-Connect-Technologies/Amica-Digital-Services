---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="section center">
    <div class="container">
      <h1>Page not found</h1>
      <p class="lead">The page may have moved. Try one of these instead.</p>
      <div class="btn-row"><a href="/" class="btn btn-primary">Home</a><a href="/services" class="btn btn-secondary">Services</a><a href="/contact" class="btn btn-secondary">Contact</a></div>
    </div>
  </section>
</Base>
