---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import posts from '../../data/blog.json';

const fmt = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog" description="Practical articles from Amica Digital Services on AI automation, digital marketing, SEO and healthcare technology for UK businesses.">
  <PageHero eyebrow="Blog" title="Insights on AI, automation and growth" lead="Practical articles on using AI, automation and digital marketing to win more customers and save time." crumbs={[{ label: 'Blog' }]} />
  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {posts.map((p) => (
          <a class="card post-card" href={`/blog/${p.slug}`}>
            <div class="media" style="aspect-ratio:16 / 9"><img src={p.coverImage} alt="" loading="lazy" decoding="async" width="800" height="450" /></div>
            <span class="tag">{p.category}</span>
            <h3>{p.title}</h3>
            <p>{p.excerpt}</p>
            <p class="meta">{fmt(p.date)} · {p.readTime}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .post-card { display: flex; flex-direction: column; gap: 10px; color: inherit; text-decoration: none; transition: transform .15s, box-shadow .15s; }
  .post-card:hover { transform: translateY(-2px); }
  .post-card .media { margin: -4px -4px 6px; border-radius: 12px; overflow: hidden; }
  .post-card .media img { width: 100%; height: 100%; object-fit: cover; }
  .post-card .tag { align-self: flex-start; }
  .post-card h3 { margin: 0; }
  .post-card p { margin: 0; }
  .meta { color: var(--muted); font-size: 0.88rem; margin-top: auto !important; }
</style>
