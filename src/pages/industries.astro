---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
const industries = [
  { id: 'care', icon: 'heart', title: 'Care and supported living agencies', text: 'Families and commissioners expect a quick, reassuring response. Care workers apply to several agencies at once.', points: ['Instant replies to care enquiries', 'Assessment and interview booking', 'Recruitment and onboarding workflows', 'Review requests from satisfied clients'], link: '/care-agency-automation' },
  { id: 'clinics', icon: 'tooth', title: 'Dental and aesthetic clinics', text: 'Treatment enquiries often come in the evening and at weekends, and no-shows cost chair time.', points: ['Enquiry follow-up and treatment booking', 'Appointment reminders and confirmations', 'No-show and reactivation campaigns', 'Review requests after appointments'] },
  { id: 'recruitment', icon: 'briefcase', title: 'Healthcare and staffing recruitment', text: 'Candidates and clients both expect fast responses, and good candidates do not stay available for long.', points: ['Candidate acknowledgement and screening questions', 'Interview scheduling', 'Compliance document reminders', 'Client enquiry pipeline'] },
  { id: 'regulated', icon: 'building', title: 'CQC-regulated and professional services', text: 'Organised, consistent communication helps you respond quickly and keep clear records.', points: ['Structured enquiry handling', 'Clear consent and privacy wording', 'Shared inbox and activity history', 'Reporting for managers'] },
];
---
<Base title="Industries We Serve" description="Amica Digital Services builds automation and CRM systems for UK care agencies, dental and aesthetic clinics, healthcare recruitment and CQC-regulated services.">
  <PageHero eyebrow="Industries" title="Built for businesses where response time matters" lead="We focus on sectors where a fast, personal reply makes the difference between winning and losing a client." crumbs={[{ label: 'Industries' }]} />
  <section class="section">
    <div class="container">
      {industries.map((i) => (
        <article class="card industry" id={i.id}>
          <div class="icon-badge"><Icon name={i.icon} /></div>
          <div>
            <h2>{i.title}</h2>
            <p class="lead">{i.text}</p>
            <ul class="checklist cols2">{i.points.map((p) => <li>{p}</li>)}</ul>
            {i.link && <a class="btn btn-primary" href={i.link} style="margin-top:12px">See the care agency package</a>}
          </div>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .industry { display: flex; gap: 24px; margin-bottom: 24px; padding: 36px; scroll-margin-top: 90px; }
  .industry h2 { font-size: 1.5rem; }
  .cols2 { columns: 2; column-gap: 32px; }
  .cols2 li { break-inside: avoid; }
  @media (max-width: 640px) { .industry { flex-direction: column; padding: 26px; } .cols2 { columns: 1; } }
</style>
