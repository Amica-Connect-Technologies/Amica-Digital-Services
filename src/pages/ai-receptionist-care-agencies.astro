---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import FlowGraphic from '../components/FlowGraphic.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { faqSchema, serviceSchema } from '../data/schema';

const title = 'AI Receptionist for Care Agencies (UK) | Amica';
const description =
  'An AI receptionist for UK care agencies that answers families and carer applicants out of hours, books call-backs and hands urgent calls to your team.';

const faqs = [
  { q: 'What is an AI receptionist for a care agency?', a: 'It is a virtual receptionist that answers your phone in a natural voice when your coordinators are busy or the office is closed. It takes details from families and carer applicants, answers common questions from information you approve, books call-backs and passes anything urgent or sensitive to a person.' },
  { q: 'Will it replace our coordinators or office staff?', a: 'No. It covers the calls your team cannot get to, such as evenings, weekends and busy rota periods, and passes every enquiry to them with the details already captured. Your coordinators still make every decision about care.' },
  { q: 'What happens if a caller has an urgent concern?', a: 'The agent is set up to recognise urgent or safeguarding concerns and pass them straight to your on-call number, or give your agreed emergency instructions. It does not give clinical advice or make safeguarding decisions.' },
  { q: 'Will callers know they are speaking to an AI?', a: 'We recommend the agent says so at the start of the call. Being open builds trust with families and applicants and avoids confusion.' },
  { q: 'Do we need a new phone number?', a: 'Not usually. Calls can be forwarded to the agent when your team is busy or outside office hours, so families keep using the number they already have.' },
  { q: 'How much does it cost?', a: 'AI voice agents are quoted individually after a short call, because cost depends on call volume, hours covered and integrations. It can be added to the Care and Recruitment Agency Automation Package, which is £490 per month on a 12-month agreement with no setup fee, or £990 setup plus £490 per month on a rolling 30-day plan.' },
];

const schema = [
  serviceSchema({
    name: 'AI Receptionist for Care Agencies',
    serviceType: 'AI receptionist',
    description,
    path: '/ai-receptionist-care-agencies',
    audience: 'Home care, supported living and care recruitment agencies',
  }),
  faqSchema(faqs),
];
---
<Base title={title} description={description} schema={schema}>
  <PageHero
    eyebrow="For UK care agencies"
    title="AI Receptionist for Home Care and Care Recruitment Agencies"
    lead="An AI receptionist for a care agency is a virtual receptionist that answers your phone when your coordinators are busy or the office is closed. It takes details from families and carer applicants, answers common questions from information you approve, books call-backs and passes anything urgent to a person. Amica Digital Services builds and manages AI receptionists for UK care agencies."
    crumbs={[{ label: 'Care and Recruitment', href: '/care-agency-automation' }, { label: 'AI Receptionist for Care Agencies' }]}
  >
    <div class="btn-row">
      <a href="/book-a-consultation" class="btn btn-primary">Book a free 20-minute call</a>
      <a href="#pricing" class="btn btn-secondary">How pricing works</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Care calls rarely arrive at a convenient time</h2>
        <p class="lead">A daughter looking for care for her father often calls in the evening, after work. A care worker looking for a new role often calls on a day off. If those calls go to voicemail, many people simply try the next agency.</p>
        <ul class="checklist crosslist" style="margin-top:20px">
          <li>Family enquiries go to voicemail during visits, meetings or rota changes</li>
          <li>Carer applicants ring outside office hours and hear nothing back</li>
          <li>The on-call phone is busy with clients, so new enquiries wait</li>
          <li>Messages are scribbled down and details are lost before anyone calls back</li>
        </ul>
      </div>
      <Picture src="/images/ai-receptionist.jpg" alt="Receptionist wearing a headset, supported by an AI voice assistant that routes calls and books call-backs" ratio="4 / 3">
        <FlowGraphic slot="fallback" />
      </Picture>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="center">
        <span class="eyebrow">What it handles</span>
        <h2>The calls it answers for you</h2>
        <p class="lead">We agree exactly which calls the agent should handle and what it may say. Everything else goes to a person.</p>
      </div>
      <div class="grid grid-3" style="margin-top:40px">
        <div class="card"><div class="icon-badge"><Icon name="heart" /></div><h3>Family and client enquiries</h3><p>Takes the caller's name, contact details, the area they live in and the type of support they are asking about, then books a call-back with a coordinator.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="users" /></div><h3>Carer applicants</h3><p>Captures the applicant's details and availability, answers common questions about applying, and sends a link to your application form or interview calendar.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="calendar" /></div><h3>Call-backs and bookings</h3><p>Books call-backs, care assessments or interviews into the right calendar, with confirmation and reminder messages.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="chat" /></div><h3>Common questions</h3><p>Answers questions such as the areas you cover and how to apply, using only information you have approved.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="mail" /></div><h3>Messages for the office</h3><p>Takes clear, complete messages and passes them to the right person, so nothing is lost on a sticky note.</p></div>
        <div class="card"><div class="icon-badge"><Icon name="crm" /></div><h3>Call summaries in your CRM</h3><p>Every call is logged against the contact with a short summary and the next step, so your team can pick it up straight away.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split" style="align-items:start">
      <div>
        <span class="eyebrow">Safe by design</span>
        <h2>What it never does</h2>
        <ul class="checklist crosslist" style="margin-top:12px">
          <li>Give clinical, medication or legal advice</li>
          <li>Make safeguarding decisions or assess risk</li>
          <li>Promise availability, start dates or prices you have not approved</li>
          <li>Pretend to be a person: we recommend it says it is an AI assistant at the start of every call</li>
        </ul>
      </div>
      <div>
        <span class="eyebrow">Escalation rules</span>
        <h2>When it hands over to a person</h2>
        <ul class="checklist" style="margin-top:12px">
          <li>Concerns about a client's safety or wellbeing go straight to your on-call number, or the caller is given your agreed emergency instructions</li>
          <li>Existing clients, families and staff with urgent issues are put through to the on-call coordinator</li>
          <li>Complaints are passed to the manager you name</li>
          <li>Any caller can ask to speak to a person at any point</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="center">
        <span class="eyebrow">Out of hours</span>
        <h2>What happens to an evening call</h2>
        <p class="lead">An example of a typical setup. It is an illustration, not a client result.</p>
      </div>
      <div class="grid grid-4 steps" style="margin-top:40px">
        <div class="card step"><h3>Answered</h3><p>A family member calls at 8pm. The agent answers, explains that it is the agency's AI assistant and asks how it can help.</p></div>
        <div class="card step"><h3>Details captured</h3><p>It takes their name, number, location and the kind of support they need, and checks whether anything is urgent.</p></div>
        <div class="card step"><h3>Call-back booked</h3><p>It books a call-back with a coordinator for the next morning and sends a text confirming the time.</p></div>
        <div class="card step"><h3>Ready for your team</h3><p>The coordinator starts the day with the enquiry, call summary and booking already in the CRM.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose" style="max-width:820px">
      <h2>How we handle personal data</h2>
      <p>We set the agent up with UK GDPR in mind. It asks only for the details needed to deal with the enquiry, callers are told how their information will be used with a link to your privacy notice, and access to call records is limited to the people who need it.</p>
      <p>The agent is for enquiries and messages, not care records. We do not process health records in the marketing system, and we agree with you what is recorded, where it is stored and how long it is kept.</p>
    </div>
  </section>

  <section class="section section-alt" id="pricing">
    <div class="container">
      <div class="center">
        <span class="eyebrow">Pricing</span>
        <h2>How pricing works</h2>
        <p class="lead">AI voice agents are quoted individually after a short call, because the cost depends on call volume, the hours you want covered and the systems it connects to.</p>
      </div>
      <div class="card specialist split" style="margin-top:36px">
        <div>
          <h3>Add it to the Care and Recruitment Agency Automation Package</h3>
          <p style="margin:0">The package covers the CRM, instant enquiry replies, missed-call text-back, assessment and interview booking, recruitment workflows and reporting. The AI receptionist sits on top, so every call it takes flows into the same follow-up.</p>
        </div>
        <div>
          <p class="price">£490<small> / month</small></p>
          <p>No setup fee on a 12-month agreement, or £990 setup plus £490 per month on a rolling 30-day plan.</p>
          <a href="/care-agency-automation" class="btn btn-primary">See the package</a>
        </div>
      </div>
      <p class="center small">Third-party usage costs, such as phone numbers, call minutes, SMS or WhatsApp, may apply and will be confirmed in your written quote before work starts.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:860px">
      <Faq items={faqs} />
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <h2>Related pages</h2>
      <div class="grid grid-3" style="margin-top:24px">
        <a href="/ai-voice-agents" class="card"><div class="icon-badge"><Icon name="phone" /></div><h3>AI receptionists and voice agents</h3><p>How our AI voice agents work for any UK business.</p><span class="more">Learn more →</span></a>
        <a href="/care-agency-automation" class="card"><div class="icon-badge"><Icon name="heart" /></div><h3>Care and recruitment automation</h3><p>The complete package for care and recruitment agencies.</p><span class="more">Learn more →</span></a>
        <a href="/blog/ai-receptionists-care-agencies-out-of-hours" class="card"><div class="icon-badge"><Icon name="clock" /></div><h3>Answering out-of-hours enquiries safely</h3><p>Our guide for care agencies thinking about an AI receptionist.</p><span class="more">Read the article →</span></a>
      </div>
    </div>
  </section>

  <CtaBand title="Find out which calls your agency is missing" />
</Base>
<style>
  .small { font-size: 0.9rem; color: var(--muted); margin-top: 24px; }
  .specialist { padding: 40px; grid-template-columns: 1.5fr 1fr; max-width: 960px; margin-left: auto; margin-right: auto; }
  @media (max-width: 900px) { .specialist { padding: 28px; } }
</style>
