---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { ghl, company } from '../data/site';
---
<Base title="Book a Free Consultation" description="Book a free 20-minute call with Amica Digital Services to see where your business is losing enquiries and how automation could help.">
  <PageHero eyebrow="Free 20-minute call" title="Book a consultation" lead="Pick a time that suits you. We will look at how enquiries reach you today and where automation could save time. No obligation and no hard sell." crumbs={[{ label: 'Book a consultation' }]} />
  <section class="section-sm">
    <div class="container split" style="align-items:start">
      <div class="card">
        <iframe src={ghl.bookingUrl} class="embed-frame" title="Book a call with Amica Digital Services" id="booking-frame" scrolling="no" loading="lazy"></iframe>
        <script is:inline src={ghl.embedScript} defer></script>
      </div>
      <div>
        <h2>What we will cover</h2>
        <ul class="checklist">
          <li>How enquiries, calls and applications reach you now</li>
          <li>Where response times slip and leads are lost</li>
          <li>Which parts of the process could be automated</li>
          <li>Whether our package is a good fit, and the likely cost</li>
        </ul>
        <p class="notice" style="margin-top:24px">Prefer to talk now? Email <a href={`mailto:${company.email}`}>{company.email}</a> or use the <a href="/contact">contact page</a>.</p>
      </div>
    </div>
  </section>
</Base>
