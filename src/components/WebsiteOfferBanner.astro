---
// Banner for the "Website from £199" entry offer. Used on /pricing, /services and /websites-software.
import { websiteOffer as W } from '../data/pricing';
---
<aside class="w199" aria-labelledby="w199-title">
  <div>
    <span class="w199-tag">Offer</span>
    <h2 id="w199-title">New business website from £{W.setup}</h2>
    <p>A professional one-page website, mobile friendly and ready for Google, live in {W.days} working days. One-off price, no monthly fee and no VAT to add. Domain and hosting are quoted separately, or we connect your own.</p>
  </div>
  <a href={W.path} class="btn btn-primary">See the £{W.setup} website</a>
</aside>
<style>
  .w199 { max-width: 920px; margin: 0 auto 40px; padding: 22px 26px; border: 2px solid var(--teal); border-radius: 16px; background: var(--teal-soft); display: flex; gap: 20px 28px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .w199 > div { flex: 1 1 420px; min-width: 0; }
  .w199 h2 { font-size: 1.3rem; margin: 6px 0 6px; }
  .w199 p { margin: 0; }
  .w199-tag { display: inline-block; background: var(--teal-dark); color: #fff; font-weight: 800; font-size: 0.78rem; letter-spacing: .04em; text-transform: uppercase; border-radius: 999px; padding: 3px 10px; }
  .w199 .btn { flex: 0 0 auto; }
</style>
