---
import { analytics } from '../data/site';
---
<div class="cookie-banner" id="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookie preferences" hidden>
  <p>
    We use essential cookies to run this site. With your permission we also use Google Analytics to understand how visitors use it.
    <a href="/cookie-policy">Cookie policy</a>
  </p>
  <div class="actions">
    <button type="button" class="btn btn-secondary" data-consent="denied">Reject</button>
    <button type="button" class="btn btn-primary" data-consent="granted">Accept analytics</button>
  </div>
</div>
<style>
  .cookie-banner { position: fixed; z-index: 60; left: 16px; right: 16px; bottom: 16px; max-width: 760px; margin: 0 auto; background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 12px 40px rgba(14,42,71,0.22); padding: 20px 22px; display: flex; gap: 18px; align-items: center; font-size: 0.95rem; }
  .cookie-banner[hidden] { display: none; }
  .cookie-banner p { margin: 0; color: var(--ink); }
  .actions { display: flex; gap: 10px; flex-shrink: 0; }
  .actions .btn { padding: 10px 18px; font-size: 0.92rem; }
  @media (max-width: 640px) { .cookie-banner { flex-direction: column; align-items: stretch; } .actions .btn { flex: 1; justify-content: center; } }
</style>
<script is:inline define:vars={{ ga4: analytics.ga4 }}>
  (function () {
    var KEY = 'amica-consent-v1';
    var banner = document.getElementById('cookie-banner');
    function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
    function loadAnalytics() {
      if (window.__amicaGa || !ga4) return;
      window.__amicaGa = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', ga4, { anonymize_ip: true });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
      document.head.appendChild(s);
    }
    var choice = read();
    if (choice === 'granted') loadAnalytics();
    else if (!choice) banner.hidden = false;
    banner.querySelectorAll('[data-consent]').forEach(function (b) {
      b.addEventListener('click', function () {
        var v = b.getAttribute('data-consent');
        save(v);
        banner.hidden = true;
        if (v === 'granted') loadAnalytics();
      });
    });
    document.querySelectorAll('[data-cookie-settings]').forEach(function (b) {
      b.addEventListener('click', function () { banner.hidden = false; });
    });
  })();
</script>
