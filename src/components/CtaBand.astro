---
const {
  title = 'See what automation could take off your team\'s plate',
  text = 'Book a free 20-minute call. We will look at how enquiries reach you today and show where time and leads are being lost. No obligation.',
} = Astro.props;
---
<section class="section-sm">
  <div class="container">
    <div class="cta-band">
      <div class="split" style="grid-template-columns: 1.4fr 1fr; gap: 32px;">
        <div>
          <h2>{title}</h2>
          <p class="lead" style="margin:0">{text}</p>
        </div>
        <div class="btn-row" style="justify-content:flex-end; margin:0">
          <a href="/book-a-consultation" class="btn btn-primary">Book a free call</a>
          <a href="/contact" class="btn btn-light">Send a message</a>
        </div>
      </div>
    </div>
  </div>
</section>
