---
const { light = false } = Astro.props;
---
<span class:list={['logo', { light }]}>
  <img src="/images/logo-mark.png" alt="" width="40" height="41" />
  <span class="logo-text">Amica <span>Digital Services</span></span>
</span>
<style>
  .logo { white-space: nowrap; display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.15rem; color: var(--navy); letter-spacing: -0.02em; }
  .logo-text span { font-weight: 600; color: var(--muted); }
  .logo.light { color: #fff; }
  .logo.light .logo-text span { color: #b9c7d6; }
</style>
