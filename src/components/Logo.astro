---
const { light = false } = Astro.props;
---
<span class:list={['logo', { light }]}>
  <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
    <rect width="40" height="40" rx="11" fill="#0e2a47" />
    <path d="M11 29L20 10l9 19" fill="none" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M14.5 22.5h11" stroke="#ef6a4c" stroke-width="3.4" stroke-linecap="round" />
    <circle cx="31" cy="11" r="3" fill="#0b8f83" />
  </svg>
  <span class="logo-text">Amica <span>Digital Services</span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.15rem; color: var(--navy); letter-spacing: -0.02em; }
  .logo-text span { font-weight: 600; color: var(--muted); }
  .logo.light { color: #fff; }
  .logo.light .logo-text span { color: #b9c7d6; }
</style>
