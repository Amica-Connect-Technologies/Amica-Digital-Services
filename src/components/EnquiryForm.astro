---
// Native qualifying enquiry form. Posts JSON to the Express server
// (/api/enquiry), which saves the lead in GoHighLevel and alerts Shaz.
// On success it fires generate_lead and dispatches "amica:enquiry-success"
// on the form (the booking page listens for it to reveal the calendar).
import { company, enquiry } from '../data/site';

interface Props {
  variant?: 'contact' | 'booking';
  submitLabel?: string;
}
const { variant = 'contact', submitLabel = variant === 'booking' ? 'Continue to pick a time' : 'Send enquiry' } = Astro.props;
const o = enquiry.options;
const successText =
  variant === 'booking'
    ? 'Thank you. Now choose a time for your call below.'
    : 'Thank you. We have your enquiry and will reply within one working hour during office hours.';
---
<form class="enquiry" novalidate data-enquiry-form data-endpoint={enquiry.endpoint} data-variant={variant} data-source-keys={enquiry.sourceKeys.join(',')}>
  <p class="enq-required-note">Fields marked <span aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required.</p>
  <div class="enq-summary" role="alert" tabindex="-1" hidden data-summary></div>

  <div class="enq-grid">
    <div class="enq-field">
      <label for="enq-firstName">First name <span class="req" aria-hidden="true">*</span></label>
      <input id="enq-firstName" name="firstName" type="text" autocomplete="given-name" maxlength="60" required aria-describedby="enq-firstName-err" />
      <p class="enq-error" id="enq-firstName-err" hidden>Enter your first name.</p>
    </div>
    <div class="enq-field">
      <label for="enq-lastName">Last name</label>
      <input id="enq-lastName" name="lastName" type="text" autocomplete="family-name" maxlength="60" />
    </div>
    <div class="enq-field">
      <label for="enq-email">Email <span class="req" aria-hidden="true">*</span></label>
      <input id="enq-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="enq-email-err" />
      <p class="enq-error" id="enq-email-err" hidden>Enter a valid email address, like name@example.co.uk.</p>
    </div>
    <div class="enq-field">
      <label for="enq-phone">Phone</label>
      <input id="enq-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" aria-describedby="enq-phone-err" />
      <p class="enq-error" id="enq-phone-err" hidden>Enter a phone number using digits, spaces and +.</p>
    </div>
    <div class="enq-field enq-wide">
      <label for="enq-companyName">Company name</label>
      <input id="enq-companyName" name="companyName" type="text" autocomplete="organization" maxlength="120" />
    </div>

    <div class="enq-field">
      <label for="enq-orgType">Organisation type <span class="req" aria-hidden="true">*</span></label>
      <select id="enq-orgType" name="orgType" required aria-describedby="enq-orgType-err">
        <option value="">Please choose</option>
        {o.orgType.map((v) => <option value={v}>{v}</option>)}
      </select>
      <p class="enq-error" id="enq-orgType-err" hidden>Choose your organisation type.</p>
    </div>
    <div class="enq-field">
      <label for="enq-role">Your role <span class="req" aria-hidden="true">*</span></label>
      <select id="enq-role" name="role" required aria-describedby="enq-role-err">
        <option value="">Please choose</option>
        {o.role.map((v) => <option value={v}>{v}</option>)}
      </select>
      <p class="enq-error" id="enq-role-err" hidden>Choose your role.</p>
    </div>
    <div class="enq-field">
      <label for="enq-teamSize">Team size <span class="req" aria-hidden="true">*</span></label>
      <select id="enq-teamSize" name="teamSize" required aria-describedby="enq-teamSize-err">
        <option value="">Please choose</option>
        {o.teamSize.map((v) => <option value={v}>{v} people</option>)}
      </select>
      <p class="enq-error" id="enq-teamSize-err" hidden>Choose your team size.</p>
    </div>
    <div class="enq-field">
      <label for="enq-budget">Monthly budget</label>
      <select id="enq-budget" name="budget">
        <option value="">Prefer not to say</option>
        {o.budget.map((v) => <option value={v}>{v}</option>)}
      </select>
    </div>

    <fieldset class="enq-field enq-wide" id="enq-mainNeed" aria-describedby="enq-mainNeed-err" data-group="mainNeed">
      <legend>Main need <span class="req" aria-hidden="true">*</span> <span class="enq-hint">Choose all that apply</span></legend>
      <div class="enq-options">
        {o.mainNeed.map((v, i) => (
          <label class="enq-check"><input type="checkbox" name="mainNeed" value={v} id={i === 0 ? 'enq-mainNeed-0' : undefined} /> <span>{v}</span></label>
        ))}
      </div>
      <p class="enq-error" id="enq-mainNeed-err" hidden>Choose at least one option.</p>
    </fieldset>

    <fieldset class="enq-field enq-wide" id="enq-timing" aria-describedby="enq-timing-err" data-group="timing">
      <legend>When would you like to start? <span class="req" aria-hidden="true">*</span></legend>
      <div class="enq-options enq-inline">
        {o.timing.map((v, i) => (
          <label class="enq-check"><input type="radio" name="timing" value={v} id={i === 0 ? 'enq-timing-0' : undefined} /> <span>{v}</span></label>
        ))}
      </div>
      <p class="enq-error" id="enq-timing-err" hidden>Choose when you would like to start.</p>
    </fieldset>

    <div class="enq-field enq-wide">
      <label for="enq-heardFrom">How did you hear about us?</label>
      <select id="enq-heardFrom" name="heardFrom">
        <option value="">Please choose</option>
        {o.heardFrom.map((v) => <option value={v}>{v}</option>)}
      </select>
    </div>
    <div class="enq-field enq-wide">
      <label for="enq-message">Anything else we should know?</label>
      <textarea id="enq-message" name="message" rows="4" maxlength="2000"></textarea>
    </div>

    <div class="enq-hp" aria-hidden="true">
      <label for="enq-hp">Leave this field empty</label>
      <input id="enq-hp" name="contact_me_by_fax_only" type="text" tabindex="-1" autocomplete="off" />
    </div>
    {enquiry.sourceKeys.map((k) => <input type="hidden" name={k} value="" />)}

    <div class="enq-field enq-wide">
      <label class="enq-check enq-consent">
        <input type="checkbox" id="enq-consent" name="consent" required aria-describedby="enq-consent-err" />
        <span>I agree to Amica Digital Services contacting me about my enquiry. <span class="req" aria-hidden="true">*</span> See our <a href="/privacy-policy">privacy policy</a>.</span>
      </label>
      <p class="enq-error" id="enq-consent-err" hidden>Tick this box so we can reply to you.</p>
    </div>
  </div>

  <button type="submit" class="btn btn-primary enq-submit">{submitLabel}</button>

  <div class="enq-fail notice" role="alert" tabindex="-1" hidden data-fail>
    <p><strong>Sorry, your enquiry did not send.</strong> Please try again, or contact us directly:</p>
    <p class="enq-fail-links">
      <a href={`tel:${company.phoneHref}`}>Call {company.phone}</a>
      <a href={`https://wa.me/${company.whatsapp}`} rel="noopener">Message us on WhatsApp</a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
    </p>
  </div>
</form>
<div class="enq-success notice" role="status" tabindex="-1" hidden data-enquiry-success>
  <p><strong data-success-title>Thank you.</strong> <span data-success-text>{successText}</span></p>
</div>

<script>
  type Detail = { firstName: string; lastName: string; email: string; phone: string; score?: string };
  const form = document.querySelector<HTMLFormElement>('form[data-enquiry-form]');
  if (form) {
    const summary = form.querySelector<HTMLElement>('[data-summary]')!;
    const fail = form.querySelector<HTMLElement>('[data-fail]')!;
    const success = form.nextElementSibling as HTMLElement;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitText = submit.textContent || '';

    // Hidden lead source values from the session capture in Base.astro.
    const lead = ((window as any).amicaLeadData || {}) as Record<string, string>;
    (form.dataset.sourceKeys || '').split(',').forEach((k) => {
      const el = form.elements.namedItem(k) as HTMLInputElement | null;
      if (el && lead[k]) el.value = String(lead[k]).slice(0, 200);
    });

    const val = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement | null)?.value || '').trim();
    const checked = (n: string) => Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${n}"]:checked`)).map((i) => i.value);
    const emailOk = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
    const phoneOk = (v: string) => !v || /^[0-9+()\-\s.]{6,30}$/.test(v);

    const checks: [string, () => boolean, string][] = [
      ['firstName', () => !!val('firstName'), 'First name'],
      ['email', () => emailOk(val('email')), 'Email'],
      ['phone', () => phoneOk(val('phone')), 'Phone'],
      ['orgType', () => !!val('orgType'), 'Organisation type'],
      ['role', () => !!val('role'), 'Your role'],
      ['teamSize', () => !!val('teamSize'), 'Team size'],
      ['mainNeed', () => checked('mainNeed').length > 0, 'Main need'],
      ['timing', () => checked('timing').length > 0, 'Start timing'],
      ['consent', () => (form.elements.namedItem('consent') as HTMLInputElement).checked, 'Consent'],
    ];

    function setError(name: string, bad: boolean) {
      const err = document.getElementById(`enq-${name}-err`);
      if (err) err.hidden = !bad;
      const group = document.getElementById(`enq-${name}`);
      const target = group && group.tagName === 'FIELDSET' ? group : (form!.elements.namedItem(name) as HTMLElement | null);
      if (target) {
        if (bad) target.setAttribute('aria-invalid', 'true');
        else target.removeAttribute('aria-invalid');
      }
    }
    function focusTarget(name: string): HTMLElement | null {
      return document.getElementById(`enq-${name}`)?.tagName === 'FIELDSET'
        ? document.getElementById(`enq-${name}-0`)
        : document.getElementById(`enq-${name}`);
    }
    function validate(): string[] {
      const bad: string[] = [];
      checks.forEach(([name, ok]) => {
        const isBad = !ok();
        setError(name, isBad);
        if (isBad) bad.push(name);
      });
      return bad;
    }
    // Clear a field's error as soon as it is fixed: while typing, not on blur, so the
    // layout does not shift under the pointer when someone clicks the next field.
    const clearFixed = (e: Event) => {
      const n = (e.target as HTMLInputElement).name;
      const c = checks.find(([name]) => name === n);
      if (c && document.getElementById(`enq-${n}-err`)?.hidden === false && c[1]()) setError(n, false);
    };
    form.addEventListener('input', clearFixed);
    form.addEventListener('change', clearFixed);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      fail.hidden = true;
      const bad = validate();
      if (bad.length) {
        const labels = checks.filter(([n]) => bad.includes(n)).map(([n, , l]) => `<li><a href="#enq-${n}">${l}</a></li>`).join('');
        summary.innerHTML = `<p><strong>Please check ${bad.length === 1 ? 'this field' : `these ${bad.length} fields`}:</strong></p><ul>${labels}</ul>`;
        summary.hidden = false;
        summary.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', (ev) => {
            ev.preventDefault();
            focusTarget(a.getAttribute('href')!.slice(5))?.focus();
          })
        );
        focusTarget(bad[0])?.focus();
        return;
      }
      summary.hidden = true;

      const payload: Record<string, unknown> = {
        firstName: val('firstName'),
        lastName: val('lastName'),
        email: val('email'),
        phone: val('phone'),
        companyName: val('companyName'),
        orgType: val('orgType'),
        role: val('role'),
        teamSize: val('teamSize'),
        mainNeed: checked('mainNeed'),
        timing: checked('timing')[0],
        budget: val('budget'),
        heardFrom: val('heardFrom'),
        message: val('message'),
        consent: true,
        contact_me_by_fax_only: val('contact_me_by_fax_only'),
        formPage: location.pathname,
      };
      (form.dataset.sourceKeys || '').split(',').forEach((k) => {
        if (val(k)) payload[k] = val(k);
      });

      submit.disabled = true;
      submit.textContent = 'Sending…';
      let ok = false;
      let score: string | undefined;
      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        ok = res.ok && data && data.ok === true;
        score = data && data.score;
      } catch {
        ok = false;
      }
      submit.disabled = false;
      submit.textContent = submitText;

      if (!ok) {
        fail.hidden = false;
        fail.focus?.();
        return;
      }
      const w = window as any;
      if (w.amicaTrack) w.amicaTrack('generate_lead', { form: `enquiry_${form.dataset.variant}`, lead_score: score || '' });
      const detail: Detail = {
        firstName: String(payload.firstName),
        lastName: String(payload.lastName || ''),
        email: String(payload.email),
        phone: String(payload.phone || ''),
        score,
      };
      const title = success.querySelector('[data-success-title]');
      if (title) title.textContent = `Thank you, ${detail.firstName}.`;
      form.hidden = true;
      success.hidden = false;
      success.focus();
      form.dispatchEvent(new CustomEvent('amica:enquiry-success', { detail, bubbles: true }));
    });
  }
</script>

<style>
  .enquiry { margin: 0; }
  .enq-required-note { color: var(--muted); font-size: 0.92rem; margin-bottom: 18px; }
  .enq-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 20px; }
  .enq-wide { grid-column: 1 / -1; }
  @media (max-width: 640px) { .enq-grid { grid-template-columns: 1fr; } }
  .enq-field { min-width: 0; }
  fieldset.enq-field { border: 0; padding: 0; margin: 0; }
  .enq-field > label, .enq-field legend { display: block; font-weight: 700; color: var(--navy); margin-bottom: 6px; font-size: 0.97rem; padding: 0; }
  .enq-hint { font-weight: 500; color: var(--muted); font-size: 0.88rem; }
  .req { color: #b4361b; }
  .enquiry input[type='text'], .enquiry input[type='email'], .enquiry input[type='tel'], .enquiry select, .enquiry textarea {
    width: 100%; font: inherit; font-size: 1rem; color: var(--ink); background: var(--white);
    border: 1.5px solid #b9c1ca; border-radius: 10px; padding: 11px 13px; min-height: 48px;
  }
  .enquiry textarea { resize: vertical; min-height: 110px; }
  .enquiry input:focus-visible, .enquiry select:focus-visible, .enquiry textarea:focus-visible, .enq-check input:focus-visible {
    outline: 3px solid var(--teal); outline-offset: 2px; border-color: var(--teal);
  }
  .enquiry [aria-invalid='true'] { border-color: #b4361b; }
  fieldset[aria-invalid='true'] .enq-options { border-left: 3px solid #b4361b; padding-left: 10px; }
  .enq-options { display: grid; gap: 8px; }
  .enq-inline { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
  .enq-check { display: flex; gap: 10px; align-items: flex-start; font-weight: 500; color: var(--ink); cursor: pointer; line-height: 1.45; }
  .enq-check input { width: 20px; height: 20px; margin: 2px 0 0; flex-shrink: 0; accent-color: var(--teal-dark); }
  .enq-field > label.enq-consent { font-size: 0.95rem; font-weight: 500; color: var(--ink); }
  .enq-error { color: #b4361b; font-size: 0.9rem; font-weight: 600; margin: 6px 0 0; }
  .enq-summary { background: var(--coral-soft); border-left: 4px solid #b4361b; border-radius: 8px; padding: 14px 18px; margin-bottom: 18px; color: var(--navy); }
  .enq-summary :global(ul) { margin: 4px 0 0; padding-left: 20px; }
  .enq-summary :global(p) { margin: 0; }
  .enq-submit { margin-top: 24px; }
  .enq-submit[disabled] { opacity: 0.7; cursor: wait; }
  .enq-fail { margin-top: 20px; background: var(--coral-soft); border-left-color: #b4361b; }
  .enq-fail p { margin: 0 0 8px; }
  .enq-fail-links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-weight: 700; }
  .enq-success p { margin: 0; }
  .enq-hp { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>
