---
import { breadcrumbSchema } from '../data/schema';
const { title, lead, eyebrow, crumbs = [] } = Astro.props;
// Visible breadcrumbs get matching BreadcrumbList structured data.
const crumbJson = crumbs.length > 0 ? JSON.stringify(breadcrumbSchema(crumbs, Astro.url.pathname)) : '';
---
<section class="page-hero">
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        {crumbs.map((c) => <> / {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</>)}
      </nav>
    )}
    {crumbJson && <script type="application/ld+json" set:html={crumbJson} />}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
